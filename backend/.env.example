# Copy to backend/.env and fill in. Loaded automatically when running from backend/.

# --- Anthropic (required for the chat agent) ---
ANTHROPIC_API_KEY=BLANK
ANTHROPIC_MODEL=claude-haiku-4-5
MAX_TOKENS=700

# --- GitHub (optional; without a token you get GitHub's 60 req/hr unauth limit) ---
# Give this token `repo` scope so the /api/github/stats commit count includes
# private repos too, not just public ones.
GITHUB_KEY=BLANK
GITHUB_USERNAME=osherboudara99
# Optional: a second (e.g. work) GitHub account whose commits get added to
# the same /api/github/stats total. Leave GITHUB_WORK_KEY blank to skip it.
GITHUB_WORK_KEY=BLANK
GITHUB_WORK_USERNAME=osherboudara-work

# --- Live content ---
GOOGLE_DOC_RESUME_URL=https://docs.google.com/document/d/1gql8n7U8WHkdLEu6R6wFI41tLWpnY5QiKQCwdsKMlQA/
# Leave empty to use the bundled assets/aboutme.txt; set to a link-shared Google
# Doc URL to pull aboutme live too.
GOOGLE_DOC_ABOUTME_URL=https://docs.google.com/document/d/1sN1E7O6OKJlqm_ZDi1sVd2Dt4QrZEa93t6_nNnCd4KM/
CONTENT_TTL_SECONDS=300

# --- Server / CORS / rate limit ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHAT_RATE_LIMIT=20/minute


